# NVIDIA NIM API key (required; used for every LLM, vision and embedding model)
NVIDIA_API_KEY=

# Serper.dev API key, for web-search fallback (utils/web_search.py)
SERPER_API_KEY=

# LangSmith tracing (optional; see utils/langsmith_setup.py)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multiagent-rag

# --- Accounts / deployment (all optional) ---
# Secret used to sign login tokens. Leave empty locally (one is generated in users/.auth_secret);
# set a long random value on any hosted deployment so logins survive restarts:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# Comma-separated list of web origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Where accounts and each user's documents + index are stored (mount a volume here in Docker)
USERS_ROOT=users
# Per-file upload limit in MB
MAX_UPLOAD_MB=50
